    <string name="privacy_local_body">OScan is a local-first document manager. Edge detection, perspective correction, image enhancement, and PDF generation run entirely on this Android device.</string>
    <string name="privacy_accounts_body">OScan has no user accounts, remote sync, analytics, background reporting, or advertisements. Document data leaves the device only when you explicitly share it.</string>
    <string name="privacy_sharing_body">When you share a PDF, OScan uses the standard Android share sheet. You control where and with whom files are shared.</string>
    <string name="help_camera_title">Camera &amp; import</string>
    <string name="help_camera_body">Point the camera at a paper document or import existing photos. OScan identifies document corners and outlines the scan region.</string>
    <string name="help_corners_title">Adjusting corners</string>
    <string name="help_corners_body">Drag the four boundary handles on the Crop screen to match the paper edges. Use Reset to restore the detected edges.</string>
    <string name="help_treatment_title">Original vs Magic</string>
    <string name="help_treatment_body">Choose Magic for clean, high-contrast document text or Original for unedited color photos.</string>
    <string name="help_multipage_title">Multi-page scanning</string>
    <string name="help_multipage_body">Capture or import multiple pages in one session. Reorder or replace pages before saving one local document.</string>
    <string name="help_folders_title">Folders &amp; Trash</string>
    <string name="help_folders_body">Organize documents in folders. Deleted documents move to Trash, where they can be restored or permanently removed.</string>
    <string name="help_export_title">Exporting PDF</string>
    <string name="help_export_body">Save multi-page documents as PDF files with your preferred page size and compression settings.</string>
    <string name="about_version">Version %1$s (Build %2$d)</string>
    <string name="about_tagline">Local-first document manager for Android</string>
    <string name="about_oss_title">Open-source libraries &amp; notices</string>
    <string name="about_oss_body">OScan is built with open-source software and frameworks.</string>
    <string name="about_repository">Repository</string>
    <string name="oss_compose_desc">Modern declarative UI framework and Material 3 design system</string>
